# Copy to .env for local (non-docker) runs. In docker-compose these are
# already injected as environment variables — this file matters mainly if
# you run `uvicorn app.main:app` directly on your host.

DATABASE_URL=postgresql+psycopg://postgresql:postgres@localhost:5433/AgnoCall
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=AgnoCall
MINIO_SECRET_KEY=AgnoCall123
MINIO_BUCKET=call-recordings
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=localhost:9000

# cloud | air_gapped | hybrid — see ADR-001 in the architecture docs
DEPLOYMENT_MODE=hybrid

# Required for the LLM analysis stage when DEPLOYMENT_MODE is cloud/hybrid.
# Leave blank and set DEPLOYMENT_MODE=air_gapped to route through Ollama instead.
OPENAI_API_KEY=

# Which cloud STT provider to use: deepgram | google | mock
# Falls back to MockSTTProvider automatically if the selected provider's
# credentials below are left blank.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# Stereo recordings: which channel of the PBX recording is the agent (left or right)
STEREO_AGENT_CHANNEL=left
# Path to a Google Cloud service account JSON key (used only if STT_PROVIDER=google)
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Email (scheduled reports: Settings > Scheduled reports) ----
# Leave SMTP_HOST empty to switch sending off. Restart the API and the worker after changing these.
SMTP_HOST=
SMTP_PORT=587
# starttls (usually port 587) | ssl (usually port 465) | none (plain; only for a trusted internal relay)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender shown to recipients, e.g. AgnoCall Reports <reports@yourcompany.com>
SMTP_FROM=
# The clock report schedules are read in (a time zone name such as Asia/Kolkata). Default UTC.
REPORT_TIMEZONE=UTC
# The one standard message at the top of every report email (\n = new line). Optional.
# REPORT_MESSAGE=Hello,\n\nHere is your scheduled AgnoCall analytics report. It covers real conversations only: IVR surveys, silent and very short recordings are left out of the averages and counted separately. The attached report has the full analytics: key metrics, categories, topics, sentiment, emotions, call volume, agent scores and how the AI compares with your reviewers.\n\nThis message is sent automatically.

# --- Access control -----------------------------------------------------------------
# Signs sign-in tokens. REQUIRED: the API refuses to start with the default. 32+ random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FORMS_JWT_SECRET=
# Lets MinIO's webhook call the API. Use the same value as the MinIO webhook auth_token.
INTERNAL_API_KEY=
# /docs, /redoc, /openapi.json and GraphiQL list every endpoint. Leave false in production.
API_DOCS_ENABLED=false
# Tests/dev only: allow starting with a weak FORMS_JWT_SECRET.
# ALLOW_INSECURE_DEFAULTS=true
